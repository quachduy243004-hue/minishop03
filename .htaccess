RewriteEngine On

RewriteBase /MiniShop_quachvanduy/


# ==================================================
# ADMIN AUTH
# ==================================================

RewriteRule ^admin/login/?$ index.php?area=admin&controller=auth&action=login [QSA,L]

RewriteRule ^admin/logout/?$ index.php?area=admin&controller=auth&action=logout [QSA,L]


# ==================================================
# ADMIN DASHBOARD
# ==================================================

RewriteRule ^admin/dashboard/?$ index.php?area=admin&controller=dashboard&action=index [QSA,L]


# ==================================================
# ADMIN PRODUCT
# ==================================================

RewriteRule ^admin/product/?$ index.php?area=admin&controller=product&action=index [QSA,L]

RewriteRule ^admin/product/create/?$ index.php?area=admin&controller=product&action=create [QSA,L]

RewriteRule ^admin/product/edit/?$ index.php?area=admin&controller=product&action=edit [QSA,L]

RewriteRule ^admin/product/detail/?$ index.php?area=admin&controller=product&action=detail [QSA,L]

RewriteRule ^admin/product/delete/?$ index.php?area=admin&controller=product&action=delete [QSA,L]


# ==================================================
# ADMIN CATEGORY
# ==================================================

RewriteRule ^admin/category/?$ index.php?area=admin&controller=category&action=index [QSA,L]

RewriteRule ^admin/category/create/?$ index.php?area=admin&controller=category&action=create [QSA,L]

RewriteRule ^admin/category/edit/?$ index.php?area=admin&controller=category&action=edit [QSA,L]

RewriteRule ^admin/category/delete/?$ index.php?area=admin&controller=category&action=delete [QSA,L]


# ==================================================
# ADMIN BRAND
# ==================================================

RewriteRule ^admin/brand/?$ index.php?area=admin&controller=brand&action=index [QSA,L]

RewriteRule ^admin/brand/create/?$ index.php?area=admin&controller=brand&action=create [QSA,L]

RewriteRule ^admin/brand/edit/?$ index.php?area=admin&controller=brand&action=edit [QSA,L]

RewriteRule ^admin/brand/delete/?$ index.php?area=admin&controller=brand&action=delete [QSA,L]


# ==================================================
# CLIENT PRODUCT
# ==================================================

RewriteRule ^product/?$ index.php?area=client&controller=product&action=index [QSA,L]

RewriteRule ^product/([^/]+)/?$ index.php?area=client&controller=product&action=detail&slug=$1 [QSA,L]

RewriteRule ^category/([^/]+)/?$ index.php?area=client&controller=product&action=category&slug=$1 [QSA,L]

RewriteRule ^brand/([^/]+)/?$ index.php?area=client&controller=product&action=brand&slug=$1 [QSA,L]


# ==================================================
# CART
# ==================================================

RewriteRule ^cart/?$ index.php?area=client&controller=cart&action=index [QSA,L]

RewriteRule ^cart/add/?$ index.php?area=client&controller=cart&action=add [QSA,L]

RewriteRule ^cart/update/?$ index.php?area=client&controller=cart&action=update [QSA,L]

RewriteRule ^cart/remove/?$ index.php?area=client&controller=cart&action=remove [QSA,L]

RewriteRule ^cart/count/?$ index.php?area=client&controller=cart&action=count [QSA,L]

RewriteRule ^cart/checkout/?$ index.php?area=client&controller=cart&action=checkout [QSA,L]


# ==================================================
# FILE / FOLDER THẬT
# ==================================================

RewriteCond %{REQUEST_FILENAME} -f [OR]

RewriteCond %{REQUEST_FILENAME} -d

RewriteRule ^ - [L]


# ==================================================
# HOME
# ==================================================

RewriteRule ^$ index.php?area=client&controller=home&action=index [QSA,L]


# ==================================================
# DEFAULT
# ==================================================

RewriteRule ^ index.php [QSA,L]